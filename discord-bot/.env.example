# ADAM SMASHER — Discord Bot Configuration
# Copy this file to .env and fill in your values

# Discord Bot Token (get from https://discord.com/developers/applications)
DISCORD_BOT_TOKEN=your_discord_bot_token_here

# Your Discord User ID (for authorization) - find at https://discord.id
ALLOWED_USER_IDS=your_discord_user_id

# Home channel for system notifications (Channel ID)
DISCORD_HOME_CHANNEL_ID=your_channel_id

# GitHub token for pushing data
GITHUB_TOKEN=

# AgentMail API (optional)
AGENTMAIL_API=